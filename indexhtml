  <footer class="shell">Standalone UK Pay Calculator · Your original spreadsheet is unchanged.</footer>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    (() => {
      "use strict";

      const STORAGE_KEY = "uk-pay-calculator-2026-27-v3";
      const CALENDAR_V2_STORAGE_KEY = "uk-pay-calculator-2026-27-v2";
      const CALENDAR_V1_STORAGE_KEY = "uk-pay-calculator-2026-27-v1";
      const APP_VERSION = 3;
      const TAX_YEAR = "2026/27";
      const JULY_PERIOD = 4;
      const MONTHS = ["April", "May", "June", "July", "August", "September", "October", "November", "December", "January", "February", "March"];
      const TREATMENTS = [
        ["taxable-addition", "Taxable cash addition"],
        ["non-taxable-addition", "Non-taxable cash addition"],
        ["salary-sacrifice", "Salary sacrifice / pre-tax"],
        ["post-tax-deduction", "Post-tax deduction"]
      ];

      const defaultProfile = Object.freeze({
        annualSalary: 45842.49,
        hoursPerWeek: 37.5,
        weeksPerYear: 52,
        taxRegion: "ruk",
        pointsAmount: 254.16,
        pointsTreatment: "taxable-addition",
        carAmount: 516.76,
        carTreatment: "taxable-addition",
        carLeaseAmount: 516.76,
        carLeaseTreatment: "post-tax-deduction",
        pensionAmount: 191.01,
        pensionTreatment: "salary-sacrifice",
        weekdayNightRate: 20,
        weekendDayRate: 40,
        weekendNightRate: 40,
        publicHolidayDayRate: 60,
        publicHolidayNightRate: 60,
        plainMultiplier: 1,
        timeHalfMultiplier: 1.5,
        doubleMultiplier: 2
      });

      const defaultEntry = Object.freeze({
        weekdayNightCount: 12,
        weekendDayCount: 6,
        weekendNightCount: 6,
        publicHolidayDayCount: 0,
        publicHolidayNightCount: 0,
        plainHours: 5,
        timeHalfHours: 4,
        doubleHours: 0,
        payeOverride: 1104.06,
        niOverride: 275.07
      });

      const blankEntry = Object.freeze({
        weekdayNightCount: 0,
        weekendDayCount: 0,
        weekendNightCount: 0,
        publicHolidayDayCount: 0,
        publicHolidayNightCount: 0,
        plainHours: 0,
        timeHalfHours: 0,
        doubleHours: 0,
        payeOverride: null,
        niOverride: null
      });

      const optionalEntryKeys = new Set(["payeOverride", "niOverride"]);
      let state = { version: APP_VERSION, taxYear: TAX_YEAR, periodBasis: "uk-tax-year", profile: { ...defaultProfile }, records: {}, activeMonth: JULY_PERIOD };
      let firstRun = true;
      let currentMonth = JULY_PERIOD;
      let seedAllowed = true;
      let toastTimer;

      const byId = id => document.getElementById(id);
      const money = value => new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Number.isFinite(value) ? value : 0);
      const plainNumber = value => Number.parseFloat(value);
      const finiteNonNegative = value => Number.isFinite(value) && value >= 0;
      const roundMoney = value => Math.round((value + Number.EPSILON) * 100) / 100;
      const clone = value => JSON.parse(JSON.stringify(value));

      function setTreatments() {
        document.querySelectorAll(".treatment-select").forEach(select => {
          select.innerHTML = TREATMENTS.map(([value, label]) => `<option value="${value}">${label}</option>`).join("");
        });
      }

      function setMonthOptions() {
        byId("monthSelect").innerHTML = MONTHS.map((name, index) => `<option value="${index + 1}">${index + 1} — ${taxPeriodLabel(index + 1)}</option>`).join("");
      }

      function taxPeriodLabel(period) {
        return `${MONTHS[period - 1]} ${period <= 9 ? "2026" : "2027"}`;
      }

      function normaliseProfile(candidate) {
        if (!candidate || typeof candidate !== "object") throw new Error("Missing profile");
        const profile = {};
        Object.keys(defaultProfile).forEach(key => {
          profile[key] = candidate[key] ?? defaultProfile[key];
          const expected = defaultProfile[key];
          if (typeof expected === "number" && (!Number.isFinite(profile[key]) || profile[key] < 0 || profile[key] > 10000000)) throw new Error(`Invalid profile value: ${key}`);
        });
        if (profile.annualSalary <= 0 || profile.hoursPerWeek <= 0 || profile.weeksPerYear <= 0) throw new Error("Base pay inputs must be positive");
        if (!["ruk", "scotland"].includes(profile.taxRegion)) throw new Error("Invalid tax region");
        [profile.pointsTreatment, profile.carTreatment, profile.carLeaseTreatment, profile.pensionTreatment].forEach(value => {
          if (!TREATMENTS.some(([allowed]) => allowed === value)) throw new Error("Invalid recurring-item treatment");
        });
        return profile;
      }

      function normaliseEntry(candidate) {
        if (!candidate || typeof candidate !== "object") throw new Error("Missing month entry");
        const entry = {};
        Object.keys(defaultEntry).forEach(key => {
          const value = optionalEntryKeys.has(key) && (candidate[key] === null || candidate[key] === undefined || candidate[key] === "") ? null : candidate[key];
          if (optionalEntryKeys.has(key) && value === null) {
            entry[key] = null;
            return;
          }
          if (!Number.isFinite(value) || value < 0 || value > 10000000) throw new Error(`Invalid month value: ${key}`);
          entry[key] = value;
        });
        return entry;
      }

      function normaliseState(candidate) {
        if (!candidate || candidate.version !== APP_VERSION || candidate.taxYear !== TAX_YEAR || candidate.periodBasis !== "uk-tax-year" || typeof candidate.records !== "object" || candidate.records === null) throw new Error("Unsupported saved data");
        const profile = normaliseProfile(candidate.profile);
        const records = {};
        Object.entries(candidate.records).forEach(([key, record]) => {
          const month = Number(key);
          if (!Number.isInteger(month) || month < 1 || month > 12 || !record || typeof record !== "object") throw new Error("Invalid saved month");
          if (records[String(month)]) throw new Error("Duplicate saved period");
          const savedProfile = normaliseProfile(record.profile);
          const savedEntry = normaliseEntry(record.entry);
          const results = calculate(savedProfile, savedEntry);
          if (results.taxablePay < -0.000001) throw new Error("Invalid salary sacrifice in saved month");
          records[String(month)] = {
            profile: savedProfile,
            entry: savedEntry,
            results,
            savedAt: typeof record.savedAt === "string" ? record.savedAt : ""
          };
        });
        const activeMonth = Number(candidate.activeMonth);
        return {
          version: APP_VERSION,
          taxYear: TAX_YEAR,
          periodBasis: "uk-tax-year",
          profile,
          records,
          activeMonth: Number.isInteger(activeMonth) && activeMonth >= 1 && activeMonth <= 12 ? activeMonth : 1
        };
      }

      function migrateLegacyProfile(candidate, preserveHistoricTreatment = false) {
        const carAmount = Number.isFinite(candidate?.carAmount) ? candidate.carAmount : defaultProfile.carAmount;
        return normaliseProfile({
          ...candidate,
          carAmount,
          carTreatment: preserveHistoricTreatment ? candidate.carTreatment : "taxable-addition",
          carLeaseAmount: preserveHistoricTreatment ? 0 : carAmount,
          carLeaseTreatment: "post-tax-deduction"
        });
      }

      function calendarMonthToTaxPeriod(calendarMonth) {
        if (!Number.isInteger(calendarMonth) || calendarMonth < 1 || calendarMonth > 12) throw new Error("Invalid calendar month");
        return ((calendarMonth + 8) % 12) + 1;
      }

      function migrateCalendarState(candidate, sourceVersion) {
        if (!candidate || candidate.version !== sourceVersion || ![1, 2].includes(sourceVersion) || !candidate.profile || typeof candidate.records !== "object" || candidate.records === null) throw new Error("Unsupported calendar-month data");
        const profile = sourceVersion === 1 ? migrateLegacyProfile(candidate.profile) : normaliseProfile(candidate.profile);
        const records = {};
        Object.entries(candidate.records).forEach(([key, record]) => {
          const calendarMonth = Number(key);
          if (!Number.isInteger(calendarMonth) || calendarMonth < 1 || calendarMonth > 12 || !record || typeof record !== "object") throw new Error("Invalid saved calendar month");
          const period = calendarMonthToTaxPeriod(calendarMonth);
          if (records[String(period)]) throw new Error("Duplicate saved calendar month");
          const savedProfile = sourceVersion === 1 ? migrateLegacyProfile(record.profile, true) : normaliseProfile(record.profile);
          const savedEntry = normaliseEntry(record.entry);
          const results = calculate(savedProfile, savedEntry);
          if (results.taxablePay < -0.000001) throw new Error("Invalid salary sacrifice in saved month");
          records[String(period)] = {
            profile: savedProfile,
            entry: savedEntry,
            results,
            savedAt: typeof record.savedAt === "string" ? record.savedAt : ""
          };
        });

        if (!records[String(JULY_PERIOD)]) {
          const julyProfile = normaliseProfile({ ...defaultProfile });
          const julyEntry = normaliseEntry({ ...defaultEntry });
          records[String(JULY_PERIOD)] = {
            profile: julyProfile,
            entry: julyEntry,
            results: calculate(julyProfile, julyEntry),
            savedAt: "2026-07 payslip"
          };
        }

        const oldActiveMonth = Number(candidate.activeMonth);
        const activeMonth = Number.isInteger(oldActiveMonth) && oldActiveMonth >= 1 && oldActiveMonth <= 12 ? calendarMonthToTaxPeriod(oldActiveMonth) : JULY_PERIOD;
        return { version: APP_VERSION, taxYear: TAX_YEAR, periodBasis: "uk-tax-year", profile, records, activeMonth };
      }

      function safeLoad() {
        let raw;
        try {
          raw = localStorage.getItem(STORAGE_KEY);
        } catch (error) {
          seedAllowed = false;
          notify("Browser storage could not be read. The calculator opened without changing the stored data.", true);
          return;
        }

        if (raw) {
          try {
            state = normaliseState(JSON.parse(raw));
            firstRun = false;
          } catch (error) {
            seedAllowed = false;
            notify("Saved browser data could not be read. It was preserved and has not been overwritten.", true);
          }
          return;
        }

        let unreadableLegacy = false;
        const legacySources = [
          { key: CALENDAR_V2_STORAGE_KEY, version: 2 },
          { key: CALENDAR_V1_STORAGE_KEY, version: 1 }
        ];
        for (const source of legacySources) {
          let legacyRaw;
          try {
            legacyRaw = localStorage.getItem(source.key);
          } catch (error) {
            seedAllowed = false;
            notify("Browser storage could not be read. Existing data was not changed.", true);
            return;
          }
          if (!legacyRaw) continue;
          try {
            const migratedState = migrateCalendarState(JSON.parse(legacyRaw), source.version);
            const migrationSaved = persist(migratedState);
            if (!migrationSaved) state = migratedState;
            firstRun = false;
            if (migrationSaved) notify("Saved calendar months were converted to 2026/27 tax-year periods. January to March are treated as 2027.");
            return;
          } catch (error) {
            unreadableLegacy = true;
          }
        }
        if (unreadableLegacy) notify("Earlier-version data could not be upgraded. It remains preserved under its original storage key.", true);
      }

      function persist(candidate = state) {
        if (!seedAllowed) {
          notify("Stored data is in recovery mode and was not changed. Save a month to replace it intentionally.", true);
          return false;
        }
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(candidate));
          state = candidate;
          return true;
        } catch (error) {
          notify("Browser storage is unavailable. Your current calculation still works, but it was not saved.", true);
          return false;
        }
      }

      function seedJulyPayslip() {
        if (!firstRun || !seedAllowed) return;
        const profile = normaliseProfile({ ...defaultProfile });
        const entry = normaliseEntry({ ...defaultEntry });
        const seededState = {
          version: APP_VERSION,
          taxYear: TAX_YEAR,
          periodBasis: "uk-tax-year",
          profile,
          activeMonth: JULY_PERIOD,
          records: {
            [String(JULY_PERIOD)]: {
              profile: clone(profile),
              entry: clone(entry),
              results: calculate(profile, entry),
              savedAt: "2026-07 payslip"
            }
          }
        };
        if (persist(seededState)) firstRun = false;
      }

      function notify(message, isError = false) {
        const toast = byId("toast");
        toast.textContent = message;
        toast.classList.toggle("error", isError);
        toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove("show"), 3600);
      }

      function applyObjectToInputs(data) {
        Object.entries(data).forEach(([key, value]) => {
          const element = byId(key);
          if (element) element.value = value === undefined || value === null ? "" : String(value);
        });
      }

      function collectProfile() {
        const result = {};
        Object.keys(defaultProfile).forEach(key => {
          const element = byId(key);
          result[key] = element.tagName === "SELECT" ? element.value : plainNumber(element.value);
        });
        return result;
      }

      function collectEntry() {
        const result = {};
        Object.keys(defaultEntry).forEach(key => {
          const raw = byId(key).value.trim();
          result[key] = optionalEntryKeys.has(key) && raw === "" ? null : plainNumber(raw);
        });
        return result;
      }

      function clearInvalid() {
        document.querySelectorAll("[aria-invalid='true']").forEach(element => element.setAttribute("aria-invalid", "false"));
        byId("validationMessage").classList.remove("show");
        byId("validationMessage").textContent = "";
      }

      function validate(profile, entry) {
        clearInvalid();
        const errors = [];
        const positiveKeys = ["annualSalary", "hoursPerWeek", "weeksPerYear"];
        const numericValues = { ...profile, ...entry };

        Object.entries(numericValues).forEach(([key, value]) => {
          if (typeof value !== "number") return;
          const isPositiveRequired = positiveKeys.includes(key);
          const invalid = !Number.isFinite(value) || value < 0 || (isPositiveRequired && value <= 0) || value > 10000000;
          if (invalid) {
            const element = byId(key);
            if (element) element.setAttribute("aria-invalid", "true");
            errors.push(`${element?.getAttribute("aria-label") || element?.previousElementSibling?.textContent || key} needs a valid ${isPositiveRequired ? "positive" : "non-negative"} number.`);
          }
        });

        if (!TREATMENTS.some(([value]) => value === profile.pointsTreatment) || !TREATMENTS.some(([value]) => value === profile.carTreatment) || !TREATMENTS.some(([value]) => value === profile.carLeaseTreatment) || !TREATMENTS.some(([value]) => value === profile.pensionTreatment)) {
          errors.push("Choose a valid treatment for each recurring item.");
        }

        if (!errors.length) {
          const preview = calculate(profile, entry);
          if (preview.taxablePay < -0.000001) errors.push("Salary sacrifice cannot be greater than taxable gross pay.");
        }

        if (errors.length) {
          const message = byId("validationMessage");
          message.textContent = errors[0];
          message.classList.add("show");
          document.querySelector("[aria-invalid='true']")?.focus();
          return false;
        }
        return true;
      }

      function adjustment(amount, treatment) {
        const value = finiteNonNegative(amount) ? roundMoney(amount) : 0;
        if (treatment === "taxable-addition") return { taxableAddition: value, nonTaxableAddition: 0, sacrifice: 0, postTax: 0 };
        if (treatment === "non-taxable-addition") return { taxableAddition: 0, nonTaxableAddition: value, sacrifice: 0, postTax: 0 };
        if (treatment === "salary-sacrifice") return { taxableAddition: 0, nonTaxableAddition: 0, sacrifice: value, postTax: 0 };
        return { taxableAddition: 0, nonTaxableAddition: 0, sacrifice: 0, postTax: value };
      }

      function personalAllowance(annualisedPay) {
        const reduction = Math.floor(Math.max(0, annualisedPay - 100000) / 2);
        return Math.max(0, 12570 - reduction);
      }

      function annualIncomeTax(annualisedPay, region) {
        const allowance = personalAllowance(annualisedPay);
        const taxable = Math.max(0, annualisedPay - allowance);
        let tax;
        if (region === "scotland") {
          tax =
            Math.min(taxable, 3967) * 0.19 +
            Math.min(Math.max(taxable - 3967, 0), 12989) * 0.20 +
            Math.min(Math.max(taxable - 16956, 0), 14136) * 0.21 +
            Math.min(Math.max(taxable - 31092, 0), 31338) * 0.42 +
            Math.min(Math.max(taxable - 62430, 0), 62710) * 0.45 +
            Math.max(taxable - 125140, 0) * 0.48;
        } else {
          tax =
            Math.min(taxable, 37700) * 0.20 +
            Math.min(Math.max(taxable - 37700, 0), 87440) * 0.40 +
            Math.max(taxable - 125140, 0) * 0.45;
        }
        return { allowance, taxable, tax };
      }

      function monthlyNI(monthlyPay) {
        const pay = Math.max(0, monthlyPay);
        return Math.max(0, Math.min(pay, 4189) - 1048) * 0.08 + Math.max(0, pay - 4189) * 0.02;
      }

      function calculate(profile, entry) {
        const annualHours = profile.hoursPerWeek * profile.weeksPerYear;
        const hourlyRate = annualHours > 0 ? roundMoney(profile.annualSalary / annualHours) : 0;
        const basicMonthly = roundMoney(profile.annualSalary / 12);
        const onCallItems = {
          weekdayNight: roundMoney(entry.weekdayNightCount * profile.weekdayNightRate),
          weekendDay: roundMoney(entry.weekendDayCount * profile.weekendDayRate),
          weekendNight: roundMoney(entry.weekendNightCount * profile.weekendNightRate),
          publicHolidayDay: roundMoney(entry.publicHolidayDayCount * profile.publicHolidayDayRate),
          publicHolidayNight: roundMoney(entry.publicHolidayNightCount * profile.publicHolidayNightRate)
        };
        const onCall = roundMoney(Object.values(onCallItems).reduce((sum, value) => sum + value, 0));
        const overtimeItems = {
          plain: roundMoney(entry.plainHours * profile.plainMultiplier * hourlyRate),
          timeHalf: roundMoney(entry.timeHalfHours * profile.timeHalfMultiplier * hourlyRate),
          double: roundMoney(entry.doubleHours * profile.doubleMultiplier * hourlyRate)
        };
        const overtime = roundMoney(Object.values(overtimeItems).reduce((sum, value) => sum + value, 0));
        const contractualGross = roundMoney(basicMonthly + onCall + overtime);
        const effects = [
          adjustment(profile.pointsAmount, profile.pointsTreatment),
          adjustment(profile.carAmount, profile.carTreatment),
          adjustment(profile.carLeaseAmount, profile.carLeaseTreatment),
          adjustment(profile.pensionAmount, profile.pensionTreatment)
        ].reduce((total, item) => ({
          taxableAddition: roundMoney(total.taxableAddition + item.taxableAddition),
          nonTaxableAddition: roundMoney(total.nonTaxableAddition + item.nonTaxableAddition),
          sacrifice: roundMoney(total.sacrifice + item.sacrifice),
          postTax: roundMoney(total.postTax + item.postTax)
        }), { taxableAddition: 0, nonTaxableAddition: 0, sacrifice: 0, postTax: 0 });

        const grossBeforeSacrifice = roundMoney(contractualGross + effects.taxableAddition + effects.nonTaxableAddition);
        const payslipGross = roundMoney(grossBeforeSacrifice - effects.sacrifice);
        const taxablePay = roundMoney(contractualGross + effects.taxableAddition - effects.sacrifice);
        const annualisedPay = Math.max(0, taxablePay) * 12;
        const taxInfo = annualIncomeTax(annualisedPay, profile.taxRegion);
        const estimatedIncomeTax = roundMoney(taxInfo.tax / 12);
        const estimatedNationalInsurance = roundMoney(monthlyNI(taxablePay));
        const usesActualPaye = finiteNonNegative(entry.payeOverride);
        const usesActualNI = finiteNonNegative(entry.niOverride);
        const incomeTax = usesActualPaye ? roundMoney(entry.payeOverride) : estimatedIncomeTax;
        const nationalInsurance = usesActualNI ? roundMoney(entry.niOverride) : estimatedNationalInsurance;
        const takeHome = roundMoney(payslipGross - incomeTax - nationalInsurance - effects.postTax);

        return {
          annualHours, hourlyRate, basicMonthly, onCallItems, onCall, overtimeItems, overtime,
          contractualGross, effects, grossBeforeSacrifice, payslipGross, taxablePay, annualisedPay,
          allowance: taxInfo.allowance, annualTaxableIncome: taxInfo.taxable,
          annualIncomeTax: taxInfo.tax, estimatedIncomeTax, estimatedNationalInsurance,
          usesActualPaye, usesActualNI, incomeTax, nationalInsurance, takeHome
        };
      }

      function setMoney(id, value, negative = false) {
        byId(id).textContent = `${negative && value > 0 ? "−" : ""}${money(Math.abs(value))}`;
      }

      function renderResults() {
        const profile = collectProfile();
        const entry = collectEntry();
        const result = calculate(profile, entry);
        setMoney("basicMonthlyDisplay", result.basicMonthly);
        setMoney("hourlyRateDisplay", result.hourlyRate);
        setMoney("weekdayNightTotal", result.onCallItems.weekdayNight);
        setMoney("weekendDayTotal", result.onCallItems.weekendDay);
        setMoney("weekendNightTotal", result.onCallItems.weekendNight);
        setMoney("publicHolidayDayTotal", result.onCallItems.publicHolidayDay);
        setMoney("publicHolidayNightTotal", result.onCallItems.publicHolidayNight);
        setMoney("plainTotal", result.overtimeItems.plain);
        setMoney("timeHalfTotal", result.overtimeItems.timeHalf);
        setMoney("doubleTotal", result.overtimeItems.double);
        setMoney("takeHomeDisplay", result.takeHome);
        setMoney("resultBasic", result.basicMonthly);
        setMoney("resultOnCall", result.onCall);
        setMoney("resultOvertime", result.overtime);
        setMoney("resultAdditions", result.effects.taxableAddition + result.effects.nonTaxableAddition);
        setMoney("resultPreSacrifice", result.grossBeforeSacrifice);
        setMoney("resultGross", result.payslipGross);
        setMoney("resultSacrifice", result.effects.sacrifice, true);
        setMoney("resultTaxable", result.taxablePay);
        setMoney("resultTax", result.incomeTax, true);
        setMoney("resultNI", result.nationalInsurance, true);
        setMoney("resultPostTax", result.effects.postTax, true);
        setMoney("resultAnnualised", result.annualisedPay);
        setMoney("resultAllowance", result.allowance);
        byId("resultTaxLabel").textContent = result.usesActualPaye ? "Actual PAYE" : "Estimated Income Tax";
        byId("resultNILabel").textContent = result.usesActualNI ? "Actual employee NI" : "Estimated employee NI";
        if (result.usesActualPaye || result.usesActualNI) {
          byId("taxAssumptionNote").textContent = `Using ${result.usesActualPaye && result.usesActualNI ? "actual PAYE and NI" : result.usesActualPaye ? "actual PAYE" : "actual NI"} entered from the payslip. Formula estimate: PAYE ${money(result.estimatedIncomeTax)} and NI ${money(result.estimatedNationalInsurance)}.`;
        } else {
          byId("taxAssumptionNote").textContent = "Income Tax is estimated by annualising this month. Actual PAYE can differ because of your tax code, cumulative pay and other income.";
        }
        updateMonthState();
        return result;
      }

      function currentSnapshot() {
        return { profile: collectProfile(), entry: collectEntry() };
      }

      function snapshotsMatch(left, right) {
        return JSON.stringify(left) === JSON.stringify(right);
      }

      function hasUnsavedChanges() {
        const record = state.records[String(currentMonth)];
        const current = currentSnapshot();
        if (record) return !snapshotsMatch(current, { profile: record.profile, entry: record.entry });
        const profileChanged = !snapshotsMatch(current.profile, state.profile);
        const entryChanged = Object.entries(current.entry).some(([key, value]) => optionalEntryKeys.has(key) ? value !== null : !Number.isFinite(value) || value !== 0);
        return profileChanged || entryChanged;
      }

      function requestMonthChange(month) {
        if (!Number.isInteger(month) || month < 1 || month > 12) return false;
        if (month !== currentMonth && hasUnsavedChanges() && !window.confirm(`Leave ${taxPeriodLabel(currentMonth)} without saving these month changes?`)) {
          byId("monthSelect").value = String(currentMonth);
          return false;
        }
        byId("monthSelect").value = String(month);
        loadSelectedMonth();
        return true;
      }

      function updateMonthState() {
        const month = Number(byId("monthSelect").value);
        const existing = Boolean(state.records[String(month)]);
        const dirty = existing && hasUnsavedChanges();
        const status = byId("monthStatus");
        status.textContent = existing ? (dirty ? "Saved · unsaved edits" : "Saved") : "Not saved";
        status.classList.toggle("saved", existing);
        byId("saveMonthBtn").textContent = `${existing ? "Update" : "Save"} ${taxPeriodLabel(month)} ${existing ? "in" : "to"} log`;
      }

      function renderLog() {
        const body = byId("logBody");
        const selectedMonth = Number(byId("monthSelect").value || state.activeMonth);
        const totals = { payslipGross: 0, sacrifice: 0, taxablePay: 0, incomeTax: 0, nationalInsurance: 0, postTax: 0, takeHome: 0 };
        let saved = 0;
        body.innerHTML = MONTHS.map((name, index) => {
          const month = index + 1;
          const record = state.records[String(month)];
          if (!record) {
            return `<tr class="${selectedMonth === month ? "selected" : ""}"><td class="month-cell">${month} — ${taxPeriodLabel(month)}</td><td colspan="7" class="empty">Not saved</td><td><div class="row-actions"><button class="row-btn" data-use-month="${month}" aria-label="Use ${taxPeriodLabel(month)}" type="button">Use month</button></div></td></tr>`;
          }
          saved += 1;
          const r = record.results;
          totals.payslipGross += r.payslipGross;
          totals.sacrifice += r.effects.sacrifice;
          totals.taxablePay += r.taxablePay;
          totals.incomeTax += r.incomeTax;
          totals.nationalInsurance += r.nationalInsurance;
          totals.postTax += r.effects.postTax;
          totals.takeHome += r.takeHome;
          return `<tr class="${selectedMonth === month ? "selected" : ""}">
            <td class="month-cell">${month} — ${taxPeriodLabel(month)}</td>
            <td>${money(r.payslipGross)}</td>
            <td>${money(r.effects.sacrifice)}</td>
            <td>${money(r.taxablePay)}</td>
            <td>${money(r.incomeTax)}</td>
            <td>${money(r.nationalInsurance)}</td>
            <td>${money(r.effects.postTax)}</td>
            <td><strong>${money(r.takeHome)}</strong></td>
            <td><div class="row-actions"><button class="row-btn" data-load-month="${month}" aria-label="Load ${taxPeriodLabel(month)}" type="button">Load</button><button class="row-btn delete" data-delete-month="${month}" aria-label="Delete ${taxPeriodLabel(month)}" type="button">Delete</button></div></td>
          </tr>`;
        }).join("");

        byId("logFoot").innerHTML = `<tr><td>Saved total</td><td>${money(totals.payslipGross)}</td><td>${money(totals.sacrifice)}</td><td>${money(totals.taxablePay)}</td><td>${money(totals.incomeTax)}</td><td>${money(totals.nationalInsurance)}</td><td>${money(totals.postTax)}</td><td>${money(totals.takeHome)}</td><td></td></tr>`;
        byId("savedCount").textContent = `${saved} of 12 month${saved === 1 ? "" : "s"} saved`;
      }

      function loadSelectedMonth({ forceBlank = false } = {}) {
        const month = Number(byId("monthSelect").value);
        currentMonth = month;
        persist({ ...state, activeMonth: month });
        const record = state.records[String(month)];
        if (record && !forceBlank) {
          applyObjectToInputs(record.profile);
          applyObjectToInputs(record.entry);
          clearInvalid();
        } else {
          applyObjectToInputs(state.profile);
          applyObjectToInputs(firstRun && month === JULY_PERIOD && !forceBlank ? defaultEntry : blankEntry);
        }
        renderResults();
        renderLog();
      }

      function saveMonth() {
        const month = Number(byId("monthSelect").value);
        if (!Number.isInteger(month) || month < 1 || month > 12) {
          notify("Choose a tax-year period from 1 (April) to 12 (March).", true);
          return;
        }
        const profile = collectProfile();
        const entry = collectEntry();
        if (!validate(profile, entry)) return;
        const replacingUnreadableData = !seedAllowed;
        if (replacingUnreadableData && !window.confirm("The existing browser data is unreadable. Saving this month will replace it. Continue?")) return;
        if (replacingUnreadableData) seedAllowed = true;
        const results = calculate(profile, entry);
        const nextState = clone(state);
        nextState.profile = clone(profile);
        nextState.activeMonth = month;
        nextState.records[String(month)] = { profile: clone(profile), entry: clone(entry), results: clone(results), savedAt: new Date().toISOString() };
        if (persist(nextState)) {
          firstRun = false;
          currentMonth = month;
          notify(`${taxPeriodLabel(month)} saved to the 2026/27 tax-year log.`);
        } else if (replacingUnreadableData) seedAllowed = false;
        renderResults();
        renderLog();
      }

      function deleteMonth(month) {
        if (!state.records[String(month)]) return;
        if (!window.confirm(`Delete the saved ${taxPeriodLabel(month)} snapshot? This cannot be undone.`)) return;
        const nextState = clone(state);
        delete nextState.records[String(month)];
        if (!persist(nextState)) return;
        renderLog();
        updateMonthState();
        notify(`${taxPeriodLabel(month)} was removed from the log.`);
      }

      function updateProfileStorage() {
        const profile = collectProfile();
        const entry = collectEntry();
        const numericProfile = Object.entries(profile).filter(([, value]) => typeof value === "number");
        if (numericProfile.every(([, value]) => Number.isFinite(value) && value >= 0) && profile.hoursPerWeek > 0 && profile.weeksPerYear > 0) {
          persist({ ...state, profile: clone(profile) });
        }
        renderResults();
      }

      function csvValue(value) {
        const string = String(value ?? "");
        return /[",\n]/.test(string) ? `"${string.replace(/"/g, '""')}"` : string;
      }

      function downloadFile(filename, content, type) {
        const blob = new Blob([content], { type });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement("a");
        anchor.href = url;
        anchor.download = filename;
        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }

      function exportCsv() {
        const headers = ["Tax year", "Tax-year period", "Payroll month", "Region", "Payslip gross pay", "Salary sacrifice", "Taxable pay", "PAYE used", "Formula PAYE estimate", "Employee NI used", "Formula NI estimate", "Post-tax deductions", "Take-home", "Actual deductions used", "Saved at"];
        const rows = [headers];
        MONTHS.forEach((name, index) => {
          const record = state.records[String(index + 1)];
          if (!record) return;
          const r = record.results;
          rows.push([TAX_YEAR, index + 1, taxPeriodLabel(index + 1), record.profile.taxRegion === "scotland" ? "Scotland" : "England/Wales/NI", r.payslipGross, r.effects.sacrifice, r.taxablePay, r.incomeTax, r.estimatedIncomeTax, r.nationalInsurance, r.estimatedNationalInsurance, r.effects.postTax, r.takeHome, r.usesActualPaye || r.usesActualNI ? "Yes" : "No", record.savedAt]);
        });
        if (rows.length === 1) return notify("Save at least one month before exporting the log.", true);
        downloadFile("pay-calculator-2026-27-tax-year-log.csv", rows.map(row => row.map(csvValue).join(",")).join("\n"), "text/csv;charset=utf-8");
        notify("CSV export prepared.");
      }

      function backupJson() {
        const payload = { app: "UK Pay Calculator", version: APP_VERSION, taxYear: TAX_YEAR, periodBasis: "uk-tax-year", exportedAt: new Date().toISOString(), state };
        downloadFile("pay-calculator-2026-27-backup.json", JSON.stringify(payload, null, 2), "application/json");
        notify("JSON backup prepared.");
      }

      function importBackup(file) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const payload = JSON.parse(reader.result);
            if (!payload || ![1, 2, APP_VERSION].includes(payload.version)) throw new Error("Invalid backup");
            const convertsCalendarMonths = payload.version !== APP_VERSION;
            const importedState = convertsCalendarMonths ? migrateCalendarState(payload.state, payload.version) : normaliseState(payload.state);
            const conversionNote = convertsCalendarMonths ? " Calendar months will be converted to April–March tax-year periods; January–March will be treated as 2027." : "";
            if (!window.confirm(`Replace the current profile and saved months with this backup?${conversionNote}`)) return;
            const replacingUnreadableData = !seedAllowed;
            if (replacingUnreadableData) seedAllowed = true;
            if (!persist(importedState)) {
              if (replacingUnreadableData) seedAllowed = false;
              return;
            }
            firstRun = false;
            currentMonth = state.activeMonth;
            byId("monthSelect").value = String(state.activeMonth);
            loadSelectedMonth();
            notify("Backup imported successfully.");
          } catch (error) {
            notify("That file is not a compatible pay-calculator backup.", true);
          } finally {
            byId("importFile").value = "";
          }
        };
        reader.readAsText(file);
      }

      function bindEvents() {
        document.querySelectorAll("[data-recalc]").forEach(element => {
          const handler = element.hasAttribute("data-profile") ? updateProfileStorage : renderResults;
          element.addEventListener("input", handler);
          element.addEventListener("change", handler);
        });

        byId("monthSelect").addEventListener("change", event => requestMonthChange(Number(event.target.value)));
        byId("saveMonthBtn").addEventListener("click", saveMonth);
        byId("resetEntryBtn").addEventListener("click", () => {
          applyObjectToInputs(blankEntry);
          clearInvalid();
          renderResults();
          notify("Month inputs and actual deduction overrides cleared. The saved log was not changed.");
        });
        byId("logBody").addEventListener("click", event => {
          const load = event.target.closest("[data-load-month], [data-use-month]");
          const remove = event.target.closest("[data-delete-month]");
          if (load) {
            const month = Number(load.dataset.loadMonth || load.dataset.useMonth);
            if (requestMonthChange(month)) document.getElementById("month-title").scrollIntoView({ behavior: "smooth", block: "start" });
          }
          if (remove) deleteMonth(Number(remove.dataset.deleteMonth));
        });
        byId("exportCsvBtn").addEventListener("click", exportCsv);
        byId("backupBtn").addEventListener("click", backupJson);
        byId("importBtn").addEventListener("click", () => byId("importFile").click());
        byId("importFile").addEventListener("change", event => importBackup(event.target.files[0]));
        byId("clearLogBtn").addEventListener("click", () => {
          if (!Object.keys(state.records).length) return notify("The 2026/27 tax-year log is already empty.");
          if (!window.confirm("Clear every saved month? Your recurring profile will be kept, but the log cannot be recovered without a JSON backup.")) return;
          if (!persist({ ...state, records: {} })) return;
          renderLog();
          updateMonthState();
          notify("All saved months were cleared.");
        });
      }

      function init() {
        setTreatments();
        setMonthOptions();
        byId("pointsTreatment").value = defaultProfile.pointsTreatment;
        byId("carTreatment").value = defaultProfile.carTreatment;
        byId("carLeaseTreatment").value = defaultProfile.carLeaseTreatment;
        byId("pensionTreatment").value = defaultProfile.pensionTreatment;
        safeLoad();
        seedJulyPayslip();
        applyObjectToInputs(state.profile);
        byId("monthSelect").value = String(state.activeMonth);
        currentMonth = state.activeMonth;
        const initialRecord = state.records[String(state.activeMonth)];
        applyObjectToInputs(initialRecord ? initialRecord.profile : state.profile);
        applyObjectToInputs(initialRecord ? initialRecord.entry : (firstRun && state.activeMonth === JULY_PERIOD ? defaultEntry : blankEntry));
        bindEvents();
        renderResults();
        renderLog();
      }

      window.PayCalculator = { personalAllowance, annualIncomeTax, monthlyNI, calculate, defaults: { profile: defaultProfile, entry: defaultEntry } };
      init();
    })();
  </script>
</body>
</html>
